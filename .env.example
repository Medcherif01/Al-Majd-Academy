# GEMINI_API_KEY: Required for Gemini AI exam generation on the server.
GEMINI_API_KEY=

# MONGODB_URI: MongoDB Atlas connection string for persistent storage on Vercel/production.
# Leave empty in local preview to use the built-in server fallback store.
MONGODB_URI=

# SESSION_SECRET: Secret key for signing user session tokens (auto-generated in memory if omitted).
SESSION_SECRET=

# TEACHER_PORTAL_PASSCODE: Optional initial passcode for private Teacher Admin Portal.
# If left empty, the first teacher visiting the private Teacher Portal sets the password on first run.
TEACHER_PORTAL_PASSCODE=

# APP_URL: Public URL of the deployed application.
APP_URL=
